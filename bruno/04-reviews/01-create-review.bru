meta {
  name: Create User Review
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users/{{userId}}/reviews
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "film_id": 2,
    "message": "Отличный фильм, смотрел на одном дыхании!"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("reviewId", String(res.body.id));
  }
}
