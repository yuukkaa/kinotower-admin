meta {
  name: Create User Rating
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users/{{userId}}/ratings
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "film_id": 3,
    "ball": 5
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("ratingId", String(res.body.id));
  }
}
